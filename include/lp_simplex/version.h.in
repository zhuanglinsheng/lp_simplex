#ifndef LP_SIMPLEX_VERSION_H
#define LP_SIMPLEX_VERSION_H

#define LP_SIMPLEX_VERSION "@PROJECT_VERSION@"
#define LP_SIMPLEX_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
